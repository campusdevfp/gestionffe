# Caddy pide y renueva el certificado de Let's Encrypt solo, con que el dominio apunte al VPS.
{$DOMINIO} {
	tls {$EMAIL_TLS}
	encode zstd gzip

	# Límite de subida: los CV son de 5 MB como mucho.
	request_body {
		max_size 8MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	reverse_proxy app:8000

	log {
		output file /data/acceso.log {
			roll_size 10mb
			roll_keep 10
		}
	}
}
