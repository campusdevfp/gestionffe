# Copia este fichero a .env en el VPS y rellénalo. No lo subas al repositorio.

# Imagen publicada por GitHub Actions
IMAGEN=ghcr.io/USUARIO/practicas-empresa:latest

# Dominio y correo para el certificado HTTPS
DOMINIO=practicas.midominio.es
EMAIL_TLS=informatica@midominio.es

# Django
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=practicas.midominio.es
DJANGO_CSRF_TRUSTED_ORIGINS=https://practicas.midominio.es
DJANGO_SSL_REDIRECT=0          # el redirección a HTTPS ya la hace Caddy

# Administrador creado en el primer arranque (puedes borrar estas líneas después)
DJANGO_ADMIN_USUARIO=admin
DJANGO_ADMIN_EMAIL=informatica@midominio.es
DJANGO_ADMIN_PASSWORD=cambia-esta-contrasena

# Protección de datos: alimenta la página /privacidad/ y el pie
LOPD_RESPONSABLE=IES Ejemplo de Guadalajara
LOPD_EMAIL=secretaria@midominio.es
LOPD_DPD=protecciondedatos@midominio.es
LOPD_CONSERVACION_ANIOS=4

# Copias de seguridad
COPIAS_RETENER=14
